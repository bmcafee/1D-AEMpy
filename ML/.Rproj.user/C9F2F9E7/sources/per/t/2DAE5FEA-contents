```{r}
data_lf_sum <- data_lf %>% filter(lake_id == "ME" & variable == "poc") %>% collect() %>% filter(depth == 3) %>% mutate(obs_scaled = scale(observation))

data_hf_sum <- data_hf %>% filter(lake_id == "ME" & variable %in% c("phyco", "fdom", "chla")) %>% collect() %>% filter(datetime %in% data_lf_sum$datetime) %>% mutate(obs_scaled = scale(observation))

all_data <- rbind(data_hf_sum, data_lf_sum) 

ggplot(data = all_data, aes(x = datetime, y = obs_scaled, color = variable))+
  geom_point()+
  geom_smooth(se = FALSE)

all_data_wider <- all_data %>% select(datetime, variable, observation) %>% pivot_wider(names_from = variable, values_from = observation)

ggplot(data = all_data_wider, aes(x = poc, y = chla))+
  geom_point()+
  geom_smooth(method = "lm")
```


```{r}
data_hf_chla <- data_hf %>% filter(lake_id == "ME" & variable == "chla") %>% collect() %>% filter(lubridate::year(datetime) >= 2019) %>% mutate(scaled_obs = scale(observation))

data_lf_chla <- data_lf %>% filter(lake_id == "ME" & variable == "chla" & depth != -99) %>% collect() %>% filter(lubridate::year(datetime) >= 2016) %>% mutate(scaled_obs = scale(observation))

chla_all <- rbind(data_hf_chla, data_lf_chla)

data <- chla_all %>%
    mutate(hour = floor_date(as_datetime(datetime), unit = "hour"))%>%
    select(depth, scaled_obs, hour) %>%
    pivot_wider(names_from = depth, values_from = scaled_obs, values_fn = mean)
names(data)[names(data) == 'hour'] <- 'datetime'
data$datetime <- format(as.POSIXct(data$datetime), "%Y-%m-%d %H:%M:%S")
filename <- paste0("C:/Users/benne/Documents/Python_Workspace/1D-AEMpy/output/", "scaled_chla", "_obs.csv")
write.csv(data, file = filename, row.names = FALSE)


