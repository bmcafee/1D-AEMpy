library(arrow) #For working with Parquet files
library(dplyr) #For manipulating data

# Step 1: Unzip the LakeBeD-US Observational Data zip file and save it to your computer, if not done so already.

# Step 2: Open each dataset
# Change the directory below to match where you have saved the LowFrequency and HighFrequency folders on your computer

data_lf <- open_dataset("LakeBeD-US 2024-09-19/LowFrequency", # this is the filepath to the LowFrequency folder
                        schema = schema(field("source", string()),
                                        field("datetime", timestamp()),
                                        field("lake_id", string()),
                                        field("depth", double()),
                                        field("variable", string()),
                                        field("unit", string()),
                                        field("observation", double()),
                                        field("flag", string())))

glimpse(data_lf) # view the structure of the data

data_hf <- open_dataset("LakeBeD-US 2024-09-19/HighFrequency", # this is the filepath to the HighFrequency folder
                        schema = schema(field("source", string()),
                                        field("datetime", timestamp()),
                                        field("lake_id", string()),
                                        field("depth", double()),
                                        field("variable", string()),
                                        field("unit", string()),
                                        field("observation", double()),
                                        field("flag", string())))

# Glimpsing the structure of the high frequency dataset may use a few gigabytes of system memory.
glimpse(data_hf)

# Step 3: Collect the data into a dataframe
# LakeBeD-US, specifically the high-frequency dataset, is too big to store on many computers as a dataframe.
# We can use dplyr commands to query the dataset. Reducing the size of the dataset makes it much easier to store in memory and work with.
# Use the 'collect' function from the arrow package to store your queried data as a dataframe.
# Below is an example query to find all of the measurements of dissolved oxygen at the surface of Lake Mendota.

mendota_surfdo <- data_hf %>% 
  filter(lake_id == "ME" & variable == "do" & depth == 1) %>% 
  select(datetime, variable, unit, observation, flag) %>% #Selecting columns of interest further reduces memory usage.
  collect()

head(mendota_surfdo)

