library(arrow) #For working with Parquet files
library(dplyr) #For manipulating data
# Step 1: Unzip the LakeBeD-US Observational Data zip file and save it to your computer, if not done so already.
# Step 2: Open each dataset
# Change the directory below to match where you have saved the LowFrequency and HighFrequency folders on your computer
data_lf <- open_dataset("C:/Users/benne/Documents/LakeBeD-US/testing/LakeBeD-US 2024-09-19/LowFrequency",
schema = schema(field("source", string()),
field("datetime", timestamp()),
field("lake_id", string()),
field("depth", double()),
field("variable", string()),
field("unit", string()),
field("observation", double()),
field("flag", string())))
me_tp <- data_lf %>% filter(lakeid == "ME" & variable == "tp") %>% collect()
me_tp <- data_lf %>% filter(lake_id == "ME" & variable == "tp") %>% collect()
View(me_tp)
me_tp <- data_lf %>% filter(lake_id == "ME" & variable == "tp" & depth == 0) %>% collect()
